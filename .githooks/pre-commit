#!/usr/bin/env bash
# ETHOS write-admission pre-commit hook.
#
# Installed by `ethos hook install` (sets core.hooksPath to .githooks). Runs the
# write-admission gate over the staged tracked files and refuses the commit when
# the verdict is "block" (a protected-root tracked write from a non-authorized
# role). This is the local commit entrance that consumes the admission verdict's
# non-zero exit code — failure-blocking moved upstream from CI to the commit
# (tao First Principle #2).
#
# Work-lane commits pass (editor-root declared = this repo). Only protected
# accepted-root tracked writes are refused here.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# Staged files added/copied/modified/renamed AND deleted — deleting a tracked
# protected-root file is a mutation the gate must see (ACMRD, not ACMR).
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMRD)
if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

if [ -x "$repo_root/.venv/bin/python" ]; then
  ethos_python="$repo_root/.venv/bin/python"
else
  ethos_python="${PYTHON:-python}"
fi
ethos_pythonpath="$repo_root/packages/ethos/src:$repo_root/packages/ethos-core/src"
PYTHONPATH="$ethos_pythonpath${PYTHONPATH:+:$PYTHONPATH}" \
  "$ethos_python" -m ethos.cli hook admit pre-tool "${staged[@]}" \
  --root "$repo_root" --editor-root "$repo_root" --json
