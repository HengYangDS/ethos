#!/usr/bin/env bash
# ETHOS write-admission pre-commit hook.
#
# Installed by `ethos hook install` (sets core.hooksPath to .githooks). Runs the
# write-admission gate over the staged tracked files and refuses the commit when
# the verdict is "block" (a protected-root tracked write from a non-authorized
# role). This is the local commit entrance that consumes the admission verdict's
# non-zero exit code — failure-blocking moved upstream from CI to the commit
# (the proof-binding invariant).
#
# Work-lane commits pass (editor-root declared = this repo). Only protected
# accepted-root tracked writes are refused here.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
runtime_runner="${repo_root}/tools/ci/scripts/with-python-runtime.sh"
runtime_python="${ETHOS_PYTHON:-${PYTHON:-${repo_root}/build/runtime/venv/bin/python}}"
ruff_config_path="ruff.toml"
ruff_cache_dir="${RUFF_CACHE_DIR:-${repo_root}/build/runtime/tool-cache/ruff}"
mkdir -p "${ruff_cache_dir}"

# Staged files added/copied/modified/renamed AND deleted — deleting a tracked
# protected-root file is a mutation the gate must see (ACMRD, not ACMR).
staged=()
while IFS= read -r path; do
  staged+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMRTD)
if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

"${repo_root}/tools/ci/scripts/run-staged-secrets-scan.sh" "${repo_root}"

staged_python=()
while IFS= read -r path; do
  staged_python+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ "${#staged_python[@]}" -gt 0 ]; then
  if ! "${runtime_runner}" -- uv run --group dev ruff format --cache-dir "${ruff_cache_dir}" --config "${ruff_config_path}" --check "${staged_python[@]}"; then
    echo "pre_commit_python_format_failed" >&2
    exit 1
  fi
fi

ethos_pythonpath="$repo_root/src"
PYTHONPATH="$ethos_pythonpath${PYTHONPATH:+:$PYTHONPATH}" \
  "${runtime_runner}" -- "${runtime_python}" -m ethos.cli hook admit pre-tool "${staged[@]}" \
  --root "$repo_root" --editor-root "$repo_root" --json
