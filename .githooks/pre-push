#!/bin/sh
# ETHOS pre-push admission: a push to a protected role (accepted/candidate) requires
# an executed proof bound to the pushed HEAD. When a checkout opts into
# ethos.pushIdentityPolicy=configured-user, every newly pushed commit must also match
# the checkout's configured Git author/committer identity. Installed via
# `ethos hook install`. git feeds "<local ref> <local sha> <remote ref> <remote sha>"
# lines on stdin.
set -e

repo_root="$(git rev-parse --show-toplevel)"
runtime_runner="${repo_root}/tools/ci/scripts/with-python-runtime.sh"
runtime_python="${ETHOS_PYTHON:-${PYTHON:-${repo_root}/build/runtime/venv/bin/python}}"
ethos_pythonpath="$repo_root/packages/ethos/src:$repo_root/packages/ethos-core/src"
receipt_path="${ETHOS_RECONCILIATION_RECEIPT:-}"
origin_head=""
origin_main_head=""
github_head=""
github_main_head=""
if [ -n "$receipt_path" ]; then
    origin_head="$(git ls-remote --exit-code origin refs/heads/dev 2>/dev/null | awk 'NR == 1 { print $1 }')"
    origin_main_head="$(git ls-remote --exit-code origin refs/heads/main 2>/dev/null | awk 'NR == 1 { print $1 }')"
    github_head="$(git ls-remote --exit-code github refs/heads/dev 2>/dev/null | awk 'NR == 1 { print $1 }')"
    github_main_head="$(git ls-remote --exit-code github refs/heads/main 2>/dev/null | awk 'NR == 1 { print $1 }')"
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$remote_ref" ] && continue
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;  # branch deletion
    esac
    if ! PYTHONPATH="$ethos_pythonpath${PYTHONPATH:+:$PYTHONPATH}" \
        "${runtime_runner}" -- "${runtime_python}" -m ethos.cli hook pre-push "$remote_ref" "$local_sha" \
        --remote-head "$remote_sha" --reconciliation-receipt "$receipt_path" \
        --observed-origin-head "$origin_head" --observed-origin-main-head "$origin_main_head" \
        --observed-github-head "$github_head" --observed-github-main-head "$github_main_head" \
        --root "$repo_root" --json >/dev/null 2>&1; then
        echo "ethos: push to $remote_ref blocked by pre-push admission at $local_sha" >&2
        echo "ethos: run 'ethos hook pre-push $remote_ref $local_sha --remote-head $remote_sha --json' for details" >&2
        exit 1
    fi
done
exit 0
