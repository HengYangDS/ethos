#!/bin/sh
# ETHOS reference-transaction admission — closes the candidate-train bypass.
#
# Installed by `ethos hook install`. git runs this hook for every ref update with the
# transaction state as $1 (prepared | committed | aborted) and feeds
# "<old-oid> <new-oid> <ref-name>" lines on stdin. Exiting non-zero during "prepared"
# ABORTS the whole transaction — the surface that makes an out-of-band accepted-branch
# move (git merge --ff-only work/x dev, git branch -f, git reset, direct git commit on
# the accepted checkout) unreachable.
#
# There is NO escape hatch: official `ethos land --closeout` earns admission through this
# same reducer (it carries the executed proof to the target root and writes a one-shot
# closeout-intent marker BEFORE its ref move, so the accepted advance verifies as a
# legitimate admit). An earlier ETHOS_ALLOW_REF_MOVE=1 env bypass short-circuited this
# hook and was itself a hole — any process could set it — so it was removed.
#
# Posture is asymmetric by ref:
#   * The ACCEPTED branch fails CLOSED — it advances ONLY on an explicit ETHOS admit
#     (state=admitted). A missing/old/erroring `ethos` binary, empty output, or a block
#     decision all abort the transaction. Fail-open here was the hole that let a direct
#     `git commit` onto dev bypass candidate while the CLI lagged its own hook command.
#   * Every OTHER branch fails OPEN — a governance gate must not brick ordinary work-lane
#     commits when the binary is momentarily unavailable; the always-run audit flags an
#     unarmed moat separately.
phase="$1"
case "$phase" in
    prepared|committed) ;;
    *) exit 0 ;;
esac
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# The accepted branch — the one the candidate train promotes into. ETHOS records it at
# `ethos hook install`; default to dev when unset.
accepted="$(git config --get ethos.acceptedBranch 2>/dev/null)"
[ -n "$accepted" ] || accepted="dev"

runtime_runner="${repo_root}/tools/ci/scripts/with-python-runtime.sh"
runtime_python="${ETHOS_PYTHON:-${PYTHON:-${repo_root}/build/runtime/venv/bin/python}}"
ethos_pythonpath="$repo_root/src"

# The accepted checkout owns this shell/CAS boundary.  On its prepared advance,
# however, semantic admission must run from the exact clean candidate checkout being
# promoted: incumbent imports are necessarily one tree behind the proposed ref.
resolve_candidate_runner() {
    candidate_branch="$1"
    candidate_head="$2"
    candidate_record="$(git worktree list --porcelain 2>/dev/null | awk -v want="refs/heads/${candidate_branch}" '
        /^worktree / { path = substr($0, 10); head = ""; branch = ""; next }
        /^HEAD / { head = substr($0, 6); next }
        /^branch / { branch = substr($0, 8); next }
        /^$/ {
            if (branch == want) { print path "\t" head; found = 1; exit }
            path = ""; head = ""; branch = ""
        }
        END {
            if (!found && branch == want) { print path "\t" head }
        }
    ')"
    candidate_root="$(printf '%s' "$candidate_record" | cut -f1)"
    candidate_worktree_head="$(printf '%s' "$candidate_record" | cut -f2)"
    [ -n "$candidate_root" ] || return 1
    [ "$candidate_worktree_head" = "$candidate_head" ] || return 1
    [ -d "$candidate_root" ] || return 1
    # Ignored runtime/cache state is permitted, but tracked or ordinary untracked source
    # makes the candidate checkout non-reproducible and therefore non-admissible.
    [ -z "$(git -C "$candidate_root" status --porcelain 2>/dev/null)" ] || return 1
    for candidate_path in \
        pyproject.toml \
        uv.lock \
        src/ethos/__init__.py \
        tools/ci/scripts/with-python-runtime.sh
    do
        [ -f "$candidate_root/$candidate_path" ] || return 1
        [ ! -L "$candidate_root/$candidate_path" ] || return 1
        git -C "$candidate_root" cat-file -e "$candidate_head:$candidate_path" 2>/dev/null || return 1
    done
    [ -x "$candidate_root/tools/ci/scripts/with-python-runtime.sh" ] || return 1
    printf '%s\n' "$candidate_root"
}

while read -r old_value new_value ref_name; do
    protected_ref="false"
    case "$ref_name" in
        refs/heads/*) ;;
        *) continue ;;
    esac
    branch="${ref_name#refs/heads/}"
    case "$old_value" in
        *[!0]*) old_is_zero="false" ;;
        *) old_is_zero="true" ;;
    esac
    # Closeout uses a same-value `update <ref> <head> <head>` as an atomic source-ref
    # CAS. Git exposes it here as old==new: it is not a ref move, needs neither
    # semantic admission nor committed-phase lease repair, and must not be judged
    # through the intentionally stale accepted runner. A zero==zero packed-ref event
    # remains fail-closed because Git also uses that shape for an accepted ref deletion.
    if [ "$old_is_zero" = "false" ] && [ "$old_value" = "$new_value" ]; then
        continue
    fi
    # `git worktree add -b work/<name>` creates then reasserts its fresh Work
    # Lane ref before `ethos lane start` can create a lease.  A fresh checkout
    # also lacks its checkout-local interpreter.  Do not bootstrap a full
    # runtime for that work-lane setup event: it has no lease transition to
    # repair and must not require network access merely to create the lane that
    # will own subsequent work.  Changed existing Work Lane refs still use the
    # normal hook path so their committed phase repairs the lease head.
    case "$branch" in
        work/*)
            if [ ! -x "$runtime_python" ] && \
                { [ "$old_value" = "$new_value" ] || [ "$old_is_zero" = "true" ]; }; then
                continue
            fi
            ;;
    esac
    # An accepted_ff closeout atomically advances both the accepted ref and its
    # release mirror. Both transitions are protected closeout surfaces: they need
    # the exact clean candidate semantic runner, not the incumbent checkout (which
    # remains one tree behind throughout the transaction). Ordinary refs retain the
    # existing fail-open runner path.
    if [ "$phase" = "prepared" ]; then
        release_mirror="$(awk '
            /^\[branch_roles\][[:space:]]*$/ { in_roles = 1; next }
            /^\[/ { in_roles = 0 }
            in_roles && /^[[:space:]]*release_mirror[[:space:]]*=/ {
                value = $0
                sub(/^[^=]*=[[:space:]]*"/, "", value)
                sub(/".*$/, "", value)
                print value
                exit
            }
        ' "$repo_root/.ethos/workspace.toml" 2>/dev/null)"
        [ -n "$release_mirror" ] || release_mirror="independent"
        release_branch="$(awk '
            /^\[branch_roles\][[:space:]]*$/ { in_roles = 1; next }
            /^\[/ { in_roles = 0 }
            in_roles && /^[[:space:]]*release_branch[[:space:]]*=/ {
                value = $0
                sub(/^[^=]*=[[:space:]]*"/, "", value)
                sub(/".*$/, "", value)
                print value
                exit
            }
        ' "$repo_root/.ethos/workspace.toml" 2>/dev/null)"
        [ -n "$release_branch" ] || release_branch="$(git -C "$repo_root" config --get ethos.releaseBranch 2>/dev/null)"
        [ -n "$release_branch" ] || release_branch="$(git -C "$repo_root" config --get ethos.release_branch 2>/dev/null)"
        [ -n "$release_branch" ] || release_branch="main"

        if [ "$branch" = "$accepted" ] || \
            { [ "$release_mirror" = "accepted_ff" ] && [ "$branch" = "$release_branch" ]; }; then
            protected_ref="true"
            candidate_branch="$(awk '
                /^\[branch_roles\][[:space:]]*$/ { in_roles = 1; next }
                /^\[/ { in_roles = 0 }
                in_roles && /^[[:space:]]*candidate_branch[[:space:]]*=/ {
                    value = $0
                    sub(/^[^=]*=[[:space:]]*"/, "", value)
                    sub(/".*$/, "", value)
                    print value
                    exit
                }
            ' "$repo_root/.ethos/workspace.toml" 2>/dev/null)"
            [ -n "$candidate_branch" ] || candidate_branch="$(git -C "$repo_root" config --get ethos.candidateBranch 2>/dev/null)"
            [ -n "$candidate_branch" ] || candidate_branch="$(git -C "$repo_root" config --get ethos.candidate_branch 2>/dev/null)"
            [ -n "$candidate_branch" ] || candidate_branch="candidate/dev"
            candidate_runner="$(resolve_candidate_runner "$candidate_branch" "$new_value")" || {
                echo "ethos: blocked ref move on $ref_name — candidate semantic runner is unavailable." >&2
                exit 1
            }
            candidate_root="$candidate_runner"
            candidate_runtime_runner="$candidate_root/tools/ci/scripts/with-python-runtime.sh"
            verdict="$(
                cd "$candidate_root" || exit 1
                unset PYTHONPATH
                "${candidate_runtime_runner}" -- uv run --project "$candidate_root" --locked --offline \
                    --isolated --all-packages --group dev python -m ethos.cli hook ref-transaction \
                    "$ref_name" "$old_value" "$new_value" --phase "$phase" \
                    --root "$repo_root" --json 2>/dev/null | tr -d ' \n'
            )"
        else
            verdict="$(PYTHONPATH="$ethos_pythonpath${PYTHONPATH:+:$PYTHONPATH}" \
                "${runtime_runner}" -- "${runtime_python}" -m ethos.cli hook ref-transaction \
                "$ref_name" "$old_value" "$new_value" --phase "$phase" \
                --root "$repo_root" --json 2>/dev/null | tr -d ' \n')"
        fi
    else
        verdict="$(PYTHONPATH="$ethos_pythonpath${PYTHONPATH:+:$PYTHONPATH}" \
            "${runtime_runner}" -- "${runtime_python}" -m ethos.cli hook ref-transaction \
            "$ref_name" "$old_value" "$new_value" --phase "$phase" \
            --root "$repo_root" --json 2>/dev/null | tr -d ' \n')"
    fi

    if [ "$phase" = "committed" ]; then
        case "$verdict" in
            *'"state":"lease_head_advanced"'* | *'"state":"admitted"'*) : ;;
            *)
                echo "ethos: lease repair required after ref move on $ref_name." >&2
                ;;
        esac
    elif [ "$protected_ref" = "true" ]; then
        # Accepted branch: fail CLOSED. Proceed only on an explicit admitted verdict;
        # a missing/erroring binary (empty verdict) or a block both abort.
        case "$verdict" in
            *'"state":"admitted"'*) : ;;  # explicitly admitted — allow
            *)
                echo "ethos: blocked ref move on $ref_name — the accepted branch may only" >&2
                echo "ethos: advance via 'ethos land --closeout' (candidate-validated, proven)." >&2
                exit 1
                ;;
        esac
    else
        # Non-accepted branch: fail OPEN. Abort only on an explicit block verdict.
        case "$verdict" in
            *'"decision":"block"'* | *'"action":"block"'*)
                echo "ethos: blocked ref move on $ref_name." >&2
                exit 1
                ;;
        esac
    fi
done
exit 0
