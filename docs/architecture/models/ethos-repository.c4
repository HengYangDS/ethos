# ETHOS repository projection source.
# This compact C4-like source is rendered by tools/ci/architecture_projection.py.
# It is a projection input, not a new architecture truth center.

system ETHOS "Evidence-grounded repository governance"
container Git "Git substrate" "Branches, refs, worktrees, HEAD binding"
container OpenSpec "OpenSpec governance" "Official specs and active changes"
container Evidence "Attestations" "HEAD-bound proof and effect receipts"
container CI "Provider projections" "GitHub/GitLab templates and local emulators"
container Agents "Agent projections" "Skills and optional protocol adapters"

rel ETHOS Git "classifies repository role and mutation authority"
rel ETHOS OpenSpec "validates promoted specification obligations"
rel ETHOS Evidence "binds proof and effects to Attestations"
rel CI ETHOS "invokes owner scripts and command JSON"
rel Agents ETHOS "consume repository truth without owning it"
