{
  "name": "ethos-product-monorepo",
  "private": true,
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "distributions/npm"
  ],
  "scripts": {
    "ethos": "node distributions/npm/bin/ethos.mjs",
    "test:architecture-publisher": "node --test tests/architecture/architecture-publisher-integration.test.mjs",
    "test:architecture-publisher:installed": "node --test tests/architecture/architecture-publisher-installed.test.mjs tests/architecture/architecture-publisher-provider.test.mjs",
    "test:npm": "node --test tests/architecture/architecture-publisher-integration.test.mjs"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.14.1",
    "c8": "12.0.0",
    "micromark": "4.0.3",
    "micromark-util-decode-string": "2.0.1",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "globals": "17.13.0",
    "npm": "12.2.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@taplo/cli": "0.7.0",
    "allure": "3.20.0",
    "svgo": "4.1.0"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "1.9.0"
    },
    "micromark-extension-math": {
      "katex": "0.19.0"
    }
  }
}
