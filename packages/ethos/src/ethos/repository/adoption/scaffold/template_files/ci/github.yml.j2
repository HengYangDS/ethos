name: ethos
on:
  pull_request:
  push:
    branches:
      - dev
      - main
      - 'submit/**'
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - run: ethos status --json
      - run: ethos report --json
      - run: ethos prove --json
