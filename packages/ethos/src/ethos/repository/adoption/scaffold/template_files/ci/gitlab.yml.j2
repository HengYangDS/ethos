stages:
  - verify

workflow:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == "dev" || $CI_COMMIT_BRANCH == "main" || $CI_COMMIT_BRANCH =~ /^submit\/.+$/'
    - when: never

ethos:verify:
  stage: verify
  image: python:3.12
  script:
    - pip install uv
    - npm install -g @fission-ai/openspec@1.6.0
    - ethos status --json
    - ethos report --json
    - ethos prove --json
    - openspec validate --all --strict --json
