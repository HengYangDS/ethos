[protected_refs]
branches = ["main", "dev"]
tags = ["v*"]

[attestation]
formats = ["in-toto", "slsa", "spdx-lite"]
{% if profile in ["gitlab", "github"] %}
[host_profile]
provider = {{ profile | json }}

[host_profile.surfaces]
ci = {{ host_ci | json }}
{% endif %}

[publication]
remotes = ["origin", "github"]
