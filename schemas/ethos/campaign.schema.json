{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/campaign.schema.json",
  "title": "ETHOS Campaign",
  "type": "object",
  "required": ["id", "state", "owner", "objective", "claim_id", "steps"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "state": {"enum": ["planned", "active", "experimenting", "closed", "retired"]},
    "owner": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "id",
        "title",
        "state",
        "openspec_change",
        "work_lane",
        "claim_id",
        "closeout"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "state": {"enum": ["planned", "active", "in_progress", "landed", "closed", "retired"]},
        "openspec_change": {"type": "string", "minLength": 1},
        "work_lane": {
          "type": "string",
          "pattern": "^work/[A-Za-z0-9._-]+$"
        },
        "claim_id": {"type": "string", "minLength": 1},
        "closeout": {
          "type": "object",
          "required": ["state", "accepted_head", "candidate_head", "evidence"],
          "properties": {
            "state": {"enum": ["planned", "landed", "closed", "retired"]},
            "accepted_head": {"type": "string"},
            "candidate_head": {"type": "string"},
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
