{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/capability-profile.schema.json",
  "title": "ETHOS Capability Profile",
  "type": "object",
  "required": [
    "family",
    "owner",
    "primary_invariant",
    "routing_question",
    "boundary_rules",
    "proof_profile"
  ],
  "properties": {
    "family": {"type": "string", "minLength": 1},
    "owner": {
      "type": "object",
      "required": ["package", "scope"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "primary_invariant": {"type": "string", "minLength": 1},
    "routing_question": {"type": "string", "minLength": 1},
    "boundary_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "proof_profile": {
      "type": "object",
      "required": ["default_command", "executed_command", "required_gates"],
      "properties": {
        "default_command": {"type": "string", "minLength": 1},
        "executed_command": {"type": "string", "minLength": 1},
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
