{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/chronicle.schema.json",
  "title": "ETHOS Chronicle Event",
  "type": "object",
  "required": ["id", "subject_id", "event_type", "evidence_ids", "payload"],
  "properties": {
    "id": {"type": "string"},
    "subject_id": {"type": "string"},
    "event_type": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
