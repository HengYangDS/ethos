{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/context-bundle.schema.json",
  "title": "ETHOS Context Bundle",
  "type": "object",
  "required": [
    "truth",
    "protocols",
    "entrypoints",
    "resources",
    "rules"
  ],
  "properties": {
    "truth": {"const": "repository"},
    "protocols": {
      "type": "array",
      "items": {"type": "string"}
    },
    "entrypoints": {"type": "object"},
    "resources": {"type": "object"},
    "rules": {
      "type": "array",
      "items": {"type": "string"}
    },
    "context_projection": {"$ref": "#/$defs/contextProjection"}
  },
  "$defs": {
    "contextProjection": {
      "type": "object",
      "required": [
        "truth",
        "authority",
        "scope",
        "query",
        "query_digest",
        "untrusted_context_label",
        "selection"
      ],
      "properties": {
        "truth": {"const": "repository"},
        "authority": {"const": "projection"},
        "scope": {"type": "string"},
        "query": {"const": "<redacted-query>"},
        "query_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "untrusted_context_label": {"const": "UNTRUSTED CONTEXT"},
        "selection": {"$ref": "#/$defs/contextSelectionReport"}
      },
      "additionalProperties": false
    },
    "contextSelectionReport": {
      "type": "object",
      "required": [
        "manifest_id",
        "query",
        "query_digest",
        "result_count",
        "verified_count",
        "untrusted_context_label",
        "diagnostics",
        "results"
      ],
      "properties": {
        "manifest_id": {"type": "string"},
        "query": {"const": "<redacted-query>"},
        "query_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "result_count": {"type": "integer", "minimum": 0},
        "verified_count": {"type": "integer", "minimum": 0},
        "untrusted_context_label": {"const": "UNTRUSTED CONTEXT"},
        "diagnostics": {"type": "array", "items": {"type": "object"}},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "title",
              "authority_class",
              "privacy_class",
              "score",
              "source_ref",
              "verification"
            ],
            "properties": {
              "id": {"type": "string"},
              "kind": {"type": "string"},
              "title": {"type": "string"},
              "authority_class": {
                "enum": ["retrieval_aid", "pointer_only", "quarantined"]
              },
              "privacy_class": {
                "enum": [
                  "public_pointer",
                  "repo_local",
                  "user_local",
                  "sensitive",
                  "prohibited"
                ]
              },
              "score": {"type": "number"},
              "source_ref": {
                "type": "object",
                "required": ["path", "start_line", "end_line", "sha256", "head"],
                "properties": {
                  "path": {"type": "string"},
                  "start_line": {"type": "integer", "minimum": 1},
                  "end_line": {"type": "integer", "minimum": 1},
                  "sha256": {"type": "string", "minLength": 64, "maxLength": 64},
                  "head": {"type": "string"}
                },
                "additionalProperties": false
              },
              "verification": {
                "type": "object",
                "required": ["status", "method"],
                "properties": {
                  "status": {
                    "enum": ["verified", "stale", "unverified", "suppressed"]
                  },
                  "method": {"type": "string"},
                  "reason": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
