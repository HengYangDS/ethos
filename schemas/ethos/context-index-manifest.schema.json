{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/context-index-manifest.schema.json",
  "title": "ETHOS Context Index Manifest",
  "type": "object",
  "required": [
    "id",
    "repo_id",
    "root",
    "head",
    "schema_version",
    "source_manifest_digest",
    "policy_digest",
    "privacy_ceiling",
    "dirty",
    "extractors",
    "created_at"
  ],
  "properties": {
    "id": {"type": "string"},
    "repo_id": {"type": "string"},
    "root": {"type": "string"},
    "head": {"type": "string"},
    "schema_version": {"type": "integer", "minimum": 1},
    "source_manifest_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "policy_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "privacy_ceiling": {
      "enum": ["public_pointer", "repo_local", "user_local", "sensitive", "prohibited"]
    },
    "dirty": {"type": "boolean"},
    "extractors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
