{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/coupling-audit.schema.json",
  "title": "ETHOS Coupling Audit",
  "type": "object",
  "required": [
    "ok",
    "required_gaps",
    "taxonomy",
    "git_native",
    "openspec_governance",
    "native_protocols",
    "binding_registry",
    "release_product_files",
    "release_host_profile",
    "self_hosting_toolchain",
    "scanned_product_docs"
  ],
  "properties": {
    "ok": {"type": "boolean"},
    "required_gaps": {"type": "array", "items": {"type": "string"}},
    "taxonomy": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "git_native": {
      "type": "object",
      "required": [
        "strongly_bound",
        "layer",
        "allowed_terms",
        "not_a_generic_vcs_abstraction"
      ],
      "properties": {
        "strongly_bound": {"const": true},
        "layer": {"const": "product_semantic_hard_binding"},
        "allowed_terms": {"type": "array", "items": {"type": "string"}},
        "not_a_generic_vcs_abstraction": {"const": true}
      },
      "additionalProperties": false
    },
    "openspec_governance": {
      "type": "object",
      "required": [
        "required",
        "layer",
        "capability",
        "execution_surface",
        "not_a_second_command_plane"
      ],
      "properties": {
        "required": {"const": true},
        "layer": {"const": "mandatory_governance_dependency"},
        "capability": {"type": "string"},
        "execution_surface": {"const": "profile_or_adapter_binding"},
        "not_a_second_command_plane": {"const": true}
      },
      "additionalProperties": false
    },
    "native_protocols": {
      "type": "object",
      "required": ["layer", "formats", "provider_optional"],
      "properties": {
        "layer": {"const": "native_protocol_binding"},
        "formats": {"type": "array", "items": {"type": "string"}},
        "provider_optional": {"const": false}
      },
      "additionalProperties": false
    },
    "binding_registry": {
      "type": "array",
      "items": {"$ref": "#/$defs/bindingEntry"}
    },
    "release_product_files": {"type": "array", "items": {"type": "string"}},
    "release_host_profile": {
      "type": "object",
      "required": ["provider", "layer", "surfaces"],
      "properties": {
        "provider": {"type": "string"},
        "layer": {"const": "profile_or_adapter_binding"},
        "surfaces": {"type": "object"}
      },
      "additionalProperties": true
    },
    "self_hosting_toolchain": {
      "type": "object",
      "required": [
        "profile",
        "layer",
        "gates",
        "toolchains",
        "product_ontology_anchor"
      ],
      "properties": {
        "profile": {"const": "self-hosting"},
        "layer": {"const": "self_hosting_toolchain_binding"},
        "gates": {"type": "array", "items": {"type": "string"}},
        "toolchains": {"type": "array", "items": {"type": "string"}},
        "product_ontology_anchor": {"const": false}
      },
      "additionalProperties": false
    },
    "scanned_product_docs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "bindingLayer": {
      "enum": [
        "product_semantic_hard_binding",
        "mandatory_governance_dependency",
        "native_protocol_binding",
        "self_hosting_toolchain_binding",
        "profile_or_adapter_binding",
        "default_policy",
        "legacy_evidence",
        "test_fixture"
      ]
    },
    "bindingEntry": {
      "type": "object",
      "required": [
        "id",
        "layer",
        "required",
        "owns_product_semantics",
        "adapter_replaceable"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "layer": {"$ref": "#/$defs/bindingLayer"},
        "required": {"type": "boolean"},
        "owns_product_semantics": {"type": "boolean"},
        "adapter_replaceable": {"type": "boolean"},
        "surfaces": {
          "oneOf": [
            {"type": "array", "items": {"type": "string"}},
            {"type": "object"}
          ]
        },
        "role_order": {"type": "array", "items": {"type": "string"}},
        "configured_patterns": {"type": "array", "items": {"type": "string"}},
        "not_a_second_command_plane": {"type": "boolean"},
        "not_product_substrate": {"type": "boolean"},
        "formats": {"type": "array", "items": {"type": "string"}},
        "toolchains": {"type": "array", "items": {"type": "string"}},
        "gates": {"type": "array", "items": {"type": "string"}},
        "provider": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
