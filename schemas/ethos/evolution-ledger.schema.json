{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/evolution-ledger.schema.json",
  "title": "ETHOS Evolution Ledger",
  "type": "object",
  "required": ["hypothesis"],
  "properties": {
    "hypothesis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "campaign",
          "state",
          "owner",
          "claim",
          "challenge",
          "transition",
          "proof_refs",
          "review_refs",
          "decision_refs",
          "retirement_conditions"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "campaign": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "challenge": {"type": "string", "minLength": 1},
          "transition": {"type": "string", "minLength": 1},
          "proof_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "review_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "decision_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "retirement_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
