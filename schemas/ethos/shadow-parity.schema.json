{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/shadow-parity.schema.json",
  "title": "ETHOS Shadow Parity Report",
  "type": "object",
  "required": [
    "ok",
    "state",
    "target",
    "required_gaps",
    "accepted_summary",
    "comparisons",
    "execution_packages"
  ],
  "properties": {
    "ok": {"type": "boolean"},
    "state": {"enum": ["planned", "matched", "different"]},
    "target": {"type": "string", "minLength": 1},
    "required_gaps": {"type": "array", "items": {"type": "string"}},
    "accepted_summary": {"$ref": "#/$defs/acceptedSummaryWithCommands"},
    "comparisons": {
      "type": "array",
      "items": {"$ref": "#/$defs/comparison"}
    },
    "execution_packages": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "acceptedKind": {
      "enum": ["external_product_self_audit_gap", "legacy_changed_route_noop"]
    },
    "acceptedScope": {
      "enum": ["external_product_self_audit", "legacy_changed_scope_route"]
    },
    "acceptedSummary": {
      "type": "object",
      "required": ["total_count", "kind_counts"],
      "properties": {
        "total_count": {"type": "integer", "minimum": 0},
        "kind_counts": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/acceptedKind"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": false
    },
    "acceptedSummaryWithCommands": {
      "type": "object",
      "required": ["total_count", "command_count", "kind_counts"],
      "properties": {
        "total_count": {"type": "integer", "minimum": 0},
        "command_count": {"type": "integer", "minimum": 0},
        "kind_counts": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/acceptedKind"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": false
    },
    "acceptedDifference": {
      "type": "object",
      "required": ["kind", "classification", "scope", "commands", "gaps", "reason"],
      "properties": {
        "kind": {"$ref": "#/$defs/acceptedKind"},
        "classification": {"const": "accepted"},
        "scope": {"$ref": "#/$defs/acceptedScope"},
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^ethos .+"}
        },
        "gaps": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "commandResult": {
      "type": "object",
      "required": ["exit_code", "stdout", "stderr", "json"],
      "properties": {
        "exit_code": {"type": "integer"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "json": {"type": "object"}
      },
      "additionalProperties": true
    },
    "comparison": {
      "type": "object",
      "required": [
        "command",
        "external",
        "embedded",
        "semantic_diff",
        "accepted_summary",
        "accepted_differences"
      ],
      "properties": {
        "command": {"type": "string", "pattern": "^ethos .+"},
        "external": {"$ref": "#/$defs/commandResult"},
        "embedded": {"$ref": "#/$defs/commandResult"},
        "semantic_diff": {"type": "object"},
        "accepted_summary": {"$ref": "#/$defs/acceptedSummary"},
        "accepted_differences": {
          "type": "array",
          "items": {"$ref": "#/$defs/acceptedDifference"}
        }
      },
      "additionalProperties": false
    }
  }
}
