{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/skill-package-manifest.schema.json",
  "title": "ETHOS Skill Package Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "entrypoint",
    "digest_algorithm",
    "include",
    "expected_digest",
    "required_sections"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "boundary": {"type": "string"},
    "truth": {"type": "string"},
    "digest_algorithm": {"const": "sha256"},
    "include": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "exclude": {"type": "array", "items": {"type": "string"}},
    "expected_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "required_sections": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "quality": {"type": "object", "additionalProperties": true},
    "capability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "command": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
