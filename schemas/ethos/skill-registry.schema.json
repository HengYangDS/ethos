{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/skill-registry.schema.json",
  "title": "ETHOS Normalized Skill Registry",
  "type": "object",
  "required": ["schema_version", "source", "meta", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "source": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "meta": {"type": "object"},
    "coverage": {"type": "object"},
    "retired": {"type": "object"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "route_subjects",
          "activation",
          "routing",
          "obligations",
          "relations",
          "commands",
          "legacy"
        ],
        "properties": {
          "id": {"type": "string"},
          "declared_id": {"type": "string"},
          "declared_name": {"type": "string"},
          "identifier_source": {"type": "string"},
          "path": {"type": "string"},
          "package_manifest": {"type": "string"},
          "primary_subject": {"type": "string"},
          "operation": {"type": "string"},
          "authority": {"type": "string"},
          "lifecycle": {"type": "string"},
          "route_subjects": {"type": "array", "items": {"type": "string"}},
          "subjects": {"type": "array", "items": {"type": "string"}},
          "activation": {"type": "object"},
          "routing": {"type": "object"},
          "obligations": {"type": "object"},
          "relations": {"type": "object"},
          "commands": {"type": "array", "items": {"type": "string"}},
          "boundary": {"type": "string"},
          "legacy": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
