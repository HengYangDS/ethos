{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/trust-envelope.schema.json",
  "title": "ETHOS Trust Envelope",
  "type": "object",
  "required": [
    "claim_id",
    "state",
    "boundary",
    "evidence",
    "carriers",
    "fallback",
    "kill_signal",
    "promotion",
    "required_gaps"
  ],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "state": {"type": "string", "minLength": 1},
    "boundary": {
      "type": "object",
      "required": ["owner", "scope"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["dated", "digest_trusted"],
      "properties": {
        "dated": {"type": "string", "minLength": 1},
        "digest_trusted": {"type": "boolean"},
        "commands": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "carriers": {
      "type": "object",
      "required": ["openspec"],
      "properties": {
        "openspec": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "fallback": {"type": "string", "minLength": 1},
    "kill_signal": {"type": "string", "minLength": 1},
    "promotion": {
      "type": "object",
      "required": ["targets", "ready"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/promotionTarget"}
        },
        "ready": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "required_gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "promotionTarget": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "enum": ["source", "tests", "docs", "schema", "openspec", "evidence"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "description": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
