{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/workspace-status.schema.json",
  "title": "ETHOS Workspace Status",
  "type": "object",
  "required": [
    "root",
    "branch",
    "dirty",
    "changed_paths",
    "role",
    "candidate",
    "worktrees",
    "branch_bindings",
    "foreign_work_lanes",
    "coordination_gaps",
    "closeout_support",
    "required_gaps"
  ],
  "properties": {
    "root": {"type": "string"},
    "branch": {"type": "string"},
    "dirty": {"type": "boolean"},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "role": {"$ref": "#/$defs/role"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "worktrees": {"type": "array", "items": {"$ref": "#/$defs/worktree"}},
    "branch_bindings": {"type": "array", "items": {"$ref": "#/$defs/branchBinding"}},
    "foreign_work_lanes": {"type": "array", "items": {"$ref": "#/$defs/foreignWorkLane"}},
    "coordination_gaps": {"type": "array", "items": {"type": "string"}},
    "closeout_support": {"$ref": "#/$defs/closeoutSupport"},
    "required_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "release_root",
        "accepted_root",
        "candidate",
        "work_lane",
        "submit",
        "detached",
        "other"
      ]
    },
    "worktreeBinding": {
      "type": "string",
      "enum": ["current", "linked", "unbound", "absent"]
    },
    "candidate": {
      "type": "object",
      "required": [
        "branch",
        "exists",
        "head",
        "worktree_exists",
        "worktree_path",
        "worktree_binding"
      ],
      "properties": {
        "branch": {"type": "string"},
        "exists": {"type": "boolean"},
        "head": {"type": "string"},
        "worktree_exists": {"type": "boolean"},
        "worktree_path": {"type": "string"},
        "worktree_binding": {"$ref": "#/$defs/worktreeBinding"}
      },
      "additionalProperties": false
    },
    "worktree": {
      "type": "object",
      "required": ["path", "head", "branch", "role", "worktree_binding"],
      "properties": {
        "path": {"type": "string"},
        "head": {"type": "string"},
        "branch": {"type": "string"},
        "role": {"$ref": "#/$defs/role"},
        "worktree_binding": {"enum": ["current", "linked"]}
      },
      "additionalProperties": false
    },
    "branchBinding": {
      "type": "object",
      "required": ["branch", "role", "head", "worktree_path", "worktree_binding"],
      "properties": {
        "branch": {"type": "string"},
        "role": {"$ref": "#/$defs/role"},
        "head": {"type": "string"},
        "worktree_path": {"type": "string"},
        "worktree_binding": {"$ref": "#/$defs/worktreeBinding"}
      },
      "additionalProperties": false
    },
    "foreignWorkLane": {
      "type": "object",
      "required": [
        "path",
        "head",
        "branch",
        "role",
        "worktree_binding",
        "lease_owner",
        "lease_state"
      ],
      "properties": {
        "path": {"type": "string"},
        "head": {"type": "string"},
        "branch": {"type": "string"},
        "role": {"const": "work_lane"},
        "worktree_binding": {"enum": ["current", "linked"]},
        "lease_owner": {"type": "string"},
        "lease_state": {"enum": ["leased", "missing"]}
      },
      "additionalProperties": false
    },
    "closeoutSupport": {
      "type": "object",
      "required": [
        "supported",
        "branch",
        "target_branch",
        "target_path",
        "operation",
        "owner",
        "required_gaps"
      ],
      "properties": {
        "supported": {"type": "boolean"},
        "branch": {"type": "string"},
        "target_branch": {"type": "string"},
        "target_path": {"type": "string"},
        "operation": {"enum": ["land_to_candidate", ""]},
        "owner": {"type": "string"},
        "required_gaps": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
