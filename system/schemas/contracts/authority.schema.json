{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos/system/authority",
  "title": "ETHOS Contextual Authority Contract",
  "type": "object",
  "required": ["schema", "resolver", "query", "currentness", "carrier_roles", "resolution"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "system/schemas/contracts/authority.schema.json"},
    "resolver": {"type": "string", "const": "contextual"},
    "query": {
      "type": "object",
      "required": ["required", "unknown_verdict"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "const": ["subject", "predicate", "scope", "plane", "context"]
        },
        "unknown_verdict": {"type": "string", "const": "block"}
      }
    },
    "currentness": {
      "type": "object",
      "required": ["requires", "history_is_current", "projection_is_authority", "adapter_is_authority"],
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "array",
          "const": ["integrity", "declared_authority", "binding_match", "validity", "no_more_specific_active_owner"]
        },
        "history_is_current": {"const": false},
        "projection_is_authority": {"const": false},
        "adapter_is_authority": {"const": false}
      }
    },
    "carrier_roles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "may_be_authoritative"],
        "additionalProperties": false,
        "properties": {
          "name": {"enum": ["native", "projection", "adapter", "fact", "history"]},
          "may_be_authoritative": {"type": "boolean"},
          "requires_validity": {"type": "boolean"}
        }
      },
      "allOf": [
        {"contains": {"properties": {"name": {"const": "native"}, "may_be_authoritative": {"const": true}}}},
        {"contains": {"properties": {"name": {"const": "projection"}, "may_be_authoritative": {"const": false}}}},
        {"contains": {"properties": {"name": {"const": "adapter"}, "may_be_authoritative": {"const": false}}}},
        {"contains": {"properties": {"name": {"const": "fact"}, "may_be_authoritative": {"const": true}, "requires_validity": {"const": true}}}},
        {"contains": {"properties": {"name": {"const": "history"}, "may_be_authoritative": {"const": false}}}}
      ]
    },
    "resolution": {
      "type": "object",
      "required": ["conflict", "novel_semantics", "more_specific_owner"],
      "additionalProperties": false,
      "properties": {
        "conflict": {"type": "string", "const": "block"},
        "novel_semantics": {"type": "string", "const": "model_gap"},
        "more_specific_owner": {"type": "string", "const": "wins_only_within_same_query"}
      }
    }
  }
}
