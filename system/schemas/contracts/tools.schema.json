{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos/system/tools",
  "type": "object",
  "title": "ETHOS Tools Contract",
  "required": [
    "schema",
    "tool"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "tool": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "concern",
          "tool"
        ],
        "properties": {
          "concern": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          }
        }
      }
    }
  }
}
