{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos/system/tools",
  "type": "object",
  "title": "ETHOS Tools Contract",
  "required": [
    "schema",
    "tool"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "tool": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "concern",
          "tool",
          "config",
          "profile",
          "adoption"
        ],
        "properties": {
          "concern": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "config": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "adoption": {
            "type": "string",
            "enum": ["active", "candidate", "deferred", "rejected"]
          },
          "adapter_only": {
            "type": "boolean"
          },
          "artifacts": {
            "type": "string"
          },
          "checksums": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          },
          "history": {
            "type": "boolean"
          },
          "optional": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
