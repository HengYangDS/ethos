{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos/system/workflows",
  "type": "object",
  "title": "ETHOS Workflows Contract",
  "required": [
    "schema",
    "lifecycle",
    "transition",
    "guards"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "states",
        "initial"
      ],
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "initial": {
          "type": "string"
        }
      }
    },
    "transition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "guard",
          "invalid_state",
          "invalid_states"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "guard": {
            "type": "string"
          },
          "invalid_state": {
            "type": "string"
          },
          "required_facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invalid_states": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
