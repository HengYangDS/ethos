{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/assistant-projection.schema.json",
  "title": "ETHOS Assistant Projection",
  "type": "object",
  "required": ["truth", "surfaces", "rules"],
  "properties": {
    "truth": {"type": "string", "minLength": 1},
    "surfaces": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rules": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": false
}
