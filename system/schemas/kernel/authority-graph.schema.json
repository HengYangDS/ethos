{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/authority-graph.schema.json",
  "title": "ETHOS Authority Graph",
  "type": "object",
  "required": ["ok", "path", "entries", "required_gaps"],
  "properties": {
    "ok": {"type": "boolean"},
    "path": {"type": "string", "minLength": 1},
    "required_gaps": {"type": "array", "items": {"type": "string"}},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "canonical_for",
          "derived_from",
          "supersedes",
          "superseded_by",
          "doc_refs",
          "evidence_refs",
          "stable_path",
          "relation_type"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "canonical_for": {"type": "array", "items": {"type": "string"}},
          "derived_from": {"type": "array", "items": {"type": "string"}},
          "supersedes": {"type": "array", "items": {"type": "string"}},
          "superseded_by": {"type": "array", "items": {"type": "string"}},
          "doc_refs": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(docs/evidence/|claims/).+"
            }
          },
          "stable_path": {"type": "string", "minLength": 1},
          "relation_type": {
            "type": "string",
            "enum": ["authority", "derived_view", "decision", "superseded_vocabulary"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
