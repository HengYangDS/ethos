{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/campaign-closeout.schema.json",
  "title": "ETHOS Campaign Closeout",
  "type": "object",
  "required": [
    "ok",
    "state",
    "workspace",
    "claims",
    "intake_projection",
    "evolution",
    "campaigns",
    "release",
    "parity",
    "shadow_parity",
    "publication",
    "remote_publication",
    "provenance",
    "packages"
  ],
  "properties": {
    "ok": {"type": "boolean"},
    "state": {"type": "string"},
    "workspace": {"type": "object"},
    "claims": {"type": "object"},
    "intake_projection": {"$ref": "#/$defs/intakeProjection"},
    "evolution": {"type": "object"},
    "campaigns": {"$ref": "#/$defs/campaignPackage"},
    "release": {"type": "object"},
    "parity": {"type": "object"},
    "shadow_parity": {"type": "object"},
    "publication": {"$ref": "#/$defs/publication"},
    "remote_publication": {"$ref": "#/$defs/remotePublication"},
    "provenance": {"$ref": "#/$defs/closeoutProvenance"},
    "packages": {
      "type": "object",
      "required": [
        "local_closeout",
        "trust_closeout",
        "campaign",
        "intake_projection",
        "publication",
        "release",
        "parity",
        "shadow_parity"
      ],
      "properties": {
        "local_closeout": {"type": "object"},
        "trust_closeout": {"$ref": "#/$defs/trustCloseout"},
        "campaign": {"$ref": "#/$defs/campaignPackage"},
        "intake_projection": {"$ref": "#/$defs/intakeProjection"},
        "publication": {"$ref": "#/$defs/publication"},
        "release": {"type": "object"},
        "parity": {"type": "object"},
        "shadow_parity": {"$ref": "#/$defs/shadowParityPackage"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "campaignPackage": {
      "type": "object",
      "required": [
        "ok",
        "active_count",
        "campaign_count",
        "required_gaps",
        "campaigns"
      ],
      "properties": {
        "kind": {"type": "string"},
        "ok": {"type": "boolean"},
        "active_count": {"type": "integer", "minimum": 0},
        "campaign_count": {"type": "integer", "minimum": 0},
        "required_gaps": {"type": "array", "items": {"type": "string"}},
        "campaigns": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "mode",
        "remote_push",
        "remote_state",
        "submit_branch",
        "local_submit_package",
        "required_gaps",
        "next_actions"
      ],
      "properties": {
        "mode": {"const": "local_readiness"},
        "remote_push": {"const": "not_performed"},
        "remote_state": {"const": "deferred"},
        "submit_branch": {"type": "string"},
        "local_submit_package": {"type": "object"},
        "required_gaps": {"type": "array", "items": {"type": "string"}},
        "next_actions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "remotePublication": {
      "type": "object",
      "required": ["remote_push", "state", "reason"],
      "properties": {
        "remote_push": {"const": "not_performed"},
        "state": {"const": "deferred"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "intakeProjection": {
      "type": "object",
      "required": [
        "kind",
        "state",
        "truth_boundary",
        "repository_truth",
        "provider",
        "configured",
        "expected_config",
        "adapters",
        "blocking",
        "required_gaps"
      ],
      "properties": {
        "kind": {"const": "intake_projection"},
        "state": {"type": "string"},
        "truth_boundary": {"const": "projection-evidence"},
        "repository_truth": {"const": false},
        "provider": {"type": "string"},
        "configured": {"type": "boolean"},
        "expected_config": {"type": "string"},
        "adapters": {"type": "array", "items": {"type": "string"}},
        "blocking": {"type": "boolean"},
        "required_gaps": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "trustCloseout": {
      "type": "object",
      "required": [
        "kind",
        "claim_report_ok",
        "trust_claim_count",
        "promotion_ready",
        "executed_proof_evidence",
        "work_lane",
        "blocking",
        "required_gaps"
      ],
      "properties": {
        "kind": {"const": "trust_closeout"},
        "claim_report_ok": {"type": "boolean"},
        "trust_claim_count": {"type": "integer", "minimum": 0},
        "promotion_ready": {"type": "boolean"},
        "executed_proof_evidence": {"type": "boolean"},
        "work_lane": {
          "type": "object",
          "required": ["branch", "claim_id", "claim_binding"],
          "properties": {
            "branch": {"type": "string"},
            "claim_id": {"type": "string"},
            "claim_binding": {"enum": ["bound", "missing", "unbound"]}
          },
          "additionalProperties": false
        },
        "blocking": {"type": "boolean"},
        "required_gaps": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "closeoutProvenance": {
      "type": "object",
      "required": ["shadow_parity", "closeout"],
      "properties": {
        "shadow_parity": {"$ref": "#/$defs/shadowProvenance"},
        "closeout": {
          "type": "object",
          "required": ["mode", "remote_state"],
          "properties": {
            "mode": {"const": "local_only"},
            "remote_state": {"const": "deferred"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shadowParityPackage": {
      "type": "object",
      "required": [
        "state",
        "target",
        "commands",
        "semantic_dimensions",
        "blocking",
        "provenance",
        "next_action"
      ],
      "properties": {
        "kind": {"type": "string"},
        "gap": {"type": "string"},
        "state": {"type": "string"},
        "target": {"type": "string"},
        "evidence_path": {"type": "string"},
        "comparison_count": {"type": "integer", "minimum": 0},
        "commands": {"type": "array", "items": {"type": "string"}},
        "semantic_dimensions": {"type": "array", "items": {"type": "string"}},
        "blocking": {"type": "boolean"},
        "required_gaps": {"type": "array", "items": {"type": "string"}},
        "provenance": {"$ref": "#/$defs/shadowProvenance"},
        "refresh_package": {"$ref": "#/$defs/shadowRefreshPackage"},
        "next_action": {"type": "string"}
      },
      "additionalProperties": false
    },
    "shadowRefreshPackage": {
      "type": "object",
      "required": [
        "kind",
        "adopter",
        "root",
        "target",
        "blocking",
        "required_gaps",
        "command",
        "next_action"
      ],
      "properties": {
        "kind": {"const": "parity_evidence_refresh"},
        "adopter": {"type": "string"},
        "root": {"type": "string"},
        "target": {"type": "string"},
        "blocking": {"type": "boolean"},
        "required_gaps": {"type": "array", "items": {"type": "string"}},
        "command": {"type": "string"},
        "next_action": {"type": "string"}
      },
      "additionalProperties": false
    },
    "shadowProvenance": {
      "type": "object",
      "required": ["mode", "evidence_path", "freshness"],
      "properties": {
        "mode": {"enum": ["tracked_evidence", "live_shadow_run", "planned_shadow_run"]},
        "evidence_path": {"type": "string"},
        "freshness": {
          "type": "object",
          "required": [
            "ok",
            "required_gaps",
            "product_head",
            "current_product_head",
            "target_head",
            "current_target_head",
            "command_sha256"
          ],
          "properties": {
            "ok": {"type": "boolean"},
            "required_gaps": {"type": "array", "items": {"type": "string"}},
            "product_head": {"type": "string"},
            "current_product_head": {"type": "string"},
            "target_head": {"type": "string"},
            "current_target_head": {"type": "string"},
            "command_sha256": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
