{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ethos.local/schemas/handoff-acknowledgement.schema.json","title":"ETHOS Handoff Acknowledgement","type":"object","required":["acknowledgement_id","schema_version","package_id","destination_lane_ref","destination_head","destination_tree","destination_holder_ref","destination_lane_incarnation_id","destination_lease_id","destination_lease_epoch","destination_lease_expected_head","destination_lease_expires_at","destination_lease_payload_sha256","base_commitment_digest","source_lease_transferred","truth_boundary","mints_authority"],"properties":{"acknowledgement_id":{"type":"string","pattern":"^handoff-ack:[a-f0-9]{64}$"},"schema_version":{"const":1},"package_id":{"type":"string","pattern":"^handoff:[a-f0-9]{64}$"},"destination_lane_ref":{"type":"string","minLength":1},"destination_head":{"type":"string","pattern":"^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},"destination_tree":{"type":"string","pattern":"^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},"destination_holder_ref":{"type":"string","pattern":"^[^\\s:]+:[^\\s:]+:[^\\s:]+:[^\\s:]+$"},"destination_lane_incarnation_id":{"type":"string","minLength":1},"destination_lease_id":{"type":"string","minLength":1},"destination_lease_epoch":{"type":"integer","minimum":1},"destination_lease_expected_head":{"type":"string","pattern":"^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},"destination_lease_expires_at":{"type":"string","format":"date-time"},"destination_lease_payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"base_commitment_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source_lease_transferred":{"const":false},"truth_boundary":{"const":"destination_holder_asserted_local_generation"},"mints_authority":{"const":false}},"additionalProperties":false}
