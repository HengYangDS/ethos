{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ethos.local/schemas/handoff-package.schema.json","title":"ETHOS Handoff Package","type":"object","required":["schema_version","package_id","source_lane_ref","source_head","source_tree","target_holder_ref","context_digest","dirty_content_sha256","source_lease_binding","artifacts","transfers_source_lease","destination_creates_local_incarnation","truth_boundary"],"properties":{"schema_version":{"const":1},"package_id":{"type":"string","pattern":"^handoff:[a-f0-9]{64}$"},"source_lane_ref":{"type":"string","minLength":1},"source_head":{"type":"string","pattern":"^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},"source_tree":{"type":"string","pattern":"^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},"target_holder_ref":{"type":"string","pattern":"^[^:]+:[^:]+:[^:]+:[^:]+$"},"context_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"dirty_content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source_lease_binding":{"type":"object","required":["lease_id","epoch","holder_ref","expected_head","expires_at","payload_sha256"],"properties":{"lease_id":{"type":"string","minLength":1},"epoch":{"type":"integer","minimum":1},"holder_ref":{"type":"string","minLength":1},"expected_head":{"type":"string","pattern":"^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},"expires_at":{"type":"string","minLength":1},"payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false},"artifacts":{"type":"array","minItems":1,"items":{"type":"object","required":["path","sha256","kind"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"kind":{"enum":["git_bundle","context"]}},"additionalProperties":false}},"transfers_source_lease":{"const":false},"destination_creates_local_incarnation":{"const":true},"truth_boundary":{"const":"content_addressed_context_until_promoted"}},"additionalProperties":false}
