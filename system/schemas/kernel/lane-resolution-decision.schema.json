{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/lane-resolution-decision.schema.json",
  "title": "ETHOS Lane Resolution Decision",
  "type": "object",
  "required": ["schema_version", "decision_id", "disposition", "observation", "observation_digest", "evidence_refs", "reason", "break_glass", "recompute_before_effect", "reusable_authorization", "mints_authority"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["block", "preserve", "retire"]},
    "observation": {"type": "object"},
    "observation_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1},
    "break_glass": {"type": "boolean"},
    "recompute_before_effect": {"const": true},
    "reusable_authorization": {"const": false},
    "mints_authority": {"const": false}
  },
  "additionalProperties": false
}
