{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ethos.local/schemas/lane-resolution-receipt.schema.json","title":"ETHOS Lane Resolution Receipt","type":"object","required":["schema_version","receipt_id","decision_id","completed","state","observation_digest","reconciliation_required","lane_ref","head","preservation_package","preservation_manifest_sha256","mints_authority"],"properties":{"schema_version":{"const":3},"receipt_id":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"completed":{"const":true},"state":{"enum":["blocked_by_decision","preserved","retired","preserved_and_retired"]},"observation_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reconciliation_required":{"type":"boolean"},"lane_ref":{"type":"string","minLength":1},"head":{"type":"string","pattern":"^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},"preservation_package":{"type":"string"},"preservation_manifest_sha256":{"type":"string","pattern":"^(?:[a-f0-9]{64})?$"},"ownerless_closeout_binding":{"type":"object","required":["executor_ref","decision_sha256","accepted_branch","accepted_head","target_digest","target_binding_digest","postcondition_digest"],"properties":{"executor_ref":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._-]*:[^\\s:]+$"},"decision_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"accepted_branch":{"type":"string","minLength":1},"accepted_head":{"type":"string","pattern":"^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},"target_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"target_binding_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"postcondition_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false},"mints_authority":{"const":false}},"additionalProperties":false}
