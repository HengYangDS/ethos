{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/quality-profile.schema.json",
  "title": "ETHOS Quality Profile",
  "type": "object",
  "required": ["schema_version", "asset_classes", "tool_adapters"],
  "properties": {
    "schema_version": {"type": "integer"},
    "asset_classes": {
      "type": "array",
      "items": {"$ref": "quality-asset.schema.json"},
      "minItems": 1
    },
    "tool_adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "concern", "tool", "standard", "config", "profile", "adoption"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "concern": {"type": "string", "minLength": 1},
          "tool": {"type": "string", "minLength": 1},
          "standard": {"type": "string", "minLength": 1},
          "config": {"type": "string", "minLength": 1},
          "profile": {"type": "string", "minLength": 1},
          "adoption": {"enum": ["active", "candidate", "deferred", "rejected"]},
          "adapter_only": {"type": "boolean"},
          "artifacts": {"type": "string"},
          "checksums": {"type": "string"},
          "gate": {"type": "string"},
          "history": {"type": "boolean"},
          "optional": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "format_governance": {
      "type": "object",
      "required": ["human_config", "machine_contract", "host_projection", "append_only"],
      "properties": {
        "human_config": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "machine_contract": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "host_projection": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "append_only": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
