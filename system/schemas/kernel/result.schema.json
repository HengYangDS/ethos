{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/result.schema.json",
  "title": "ETHOS Result",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "state",
    "summary",
    "diagnostics",
    "required_gaps",
    "next_actions",
    "data"
  ],
  "properties": {
    "schema_version": {"type": "integer"},
    "command": {"type": "string", "minLength": 1},
    "ok": {"type": "boolean"},
    "state": {"type": "string", "minLength": 1},
    "summary": {"type": "object"},
    "diagnostics": {"type": "array", "items": {"type": "object"}},
    "required_gaps": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "governance_context": {
      "type": "object",
      "required": [
        "contract",
        "profile",
        "authority",
        "subject",
        "single_kernel",
        "kernel_chain",
        "shared_commands",
        "transition_commands",
        "reader_view_commands",
        "scorecard_commands",
        "truth_boundary",
        "profile_boundary"
      ],
      "properties": {
        "contract": {"const": "governed_repository"},
        "profile": {"type": "string", "minLength": 1},
        "authority": {"type": "object"},
        "subject": {
          "type": "object",
          "required": ["id", "kind", "name", "owner"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "repository"},
            "name": {"type": "string", "minLength": 1},
            "owner": {"type": "string", "minLength": 1},
            "metadata": {"type": "object"}
          },
          "additionalProperties": true
        },
        "single_kernel": {"const": true},
        "kernel_chain": {"type": "array", "items": {"type": "string"}},
        "shared_commands": {"type": "array", "items": {"type": "string"}},
        "transition_commands": {"type": "array", "items": {"type": "string"}},
        "reader_view_commands": {"type": "array", "items": {"type": "string"}},
        "scorecard_commands": {"type": "array", "items": {"type": "string"}},
        "truth_boundary": {"const": "repository"},
        "profile_boundary": {"const": "profile_or_adapter"}
      },
      "additionalProperties": true
    },
    "data": {"type": "object"}
  },
  "additionalProperties": false
}
