{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ETHOS Semantic Attestation Receipt","type":"object","additionalProperties":false,"required":["schema_version","kind","claim_id","evidence_sha256","scope_sha256","head","reviewer_role","reviewer_ref","basis","verdict","issued_at","valid_until","mints_authority","payload_digest"],"properties":{"schema_version":{"const":1},"kind":{"const":"semantic-attestation"},"claim_id":{"type":"string","minLength":1},"evidence_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"scope_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"head":{"type":"string","pattern":"^[a-f0-9]{40,64}$"},"reviewer_role":{"const":"independent_reviewer"},"reviewer_ref":{"type":"string","minLength":1},"basis":{"type":"string","minLength":1},"verdict":{"const":"allow"},"issued_at":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"mints_authority":{"const":false},"payload_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
