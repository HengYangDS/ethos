{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/shadow-parity.schema.json",
  "title": "ETHOS Shadow Parity Report",
  "type": "object",
  "required": [
    "ok",
    "state",
    "target",
    "identity",
    "required_gaps",
    "accepted_summary",
    "false_negative_count",
    "comparisons",
    "execution_packages"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "state": {
      "enum": [
        "planned",
        "matched",
        "different"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "required_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepted_summary": {
      "$ref": "#/$defs/acceptedSummaryWithCommands"
    },
    "false_negative_count": {
      "type": "integer",
      "minimum": 0
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "execution_packages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "identity": {
      "$ref": "#/$defs/identityEnvelope"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "acceptedKind": {
      "enum": [
        "external_product_repository_audit_gap",
        "changed_route_noop",
        "report_parity_evidence_refresh_bootstrap",
        "external_required_gap_superset"
      ]
    },
    "acceptedScope": {
      "enum": [
        "external_product_repository_audit",
        "changed_scope_route",
        "parity_evidence_refresh",
        "external_required_gap_superset"
      ]
    },
    "acceptedSummary": {
      "type": "object",
      "required": [
        "total_count",
        "kind_counts"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "kind_counts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/acceptedKind"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "acceptedSummaryWithCommands": {
      "type": "object",
      "required": [
        "total_count",
        "command_count",
        "kind_counts"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "command_count": {
          "type": "integer",
          "minimum": 0
        },
        "kind_counts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/acceptedKind"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "acceptedDifference": {
      "type": "object",
      "required": [
        "kind",
        "classification",
        "scope",
        "commands",
        "gaps",
        "reason"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/acceptedKind"
        },
        "classification": {
          "const": "accepted"
        },
        "scope": {
          "$ref": "#/$defs/acceptedScope"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ethos .+"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "commandResult": {
      "type": "object",
      "required": [
        "exit_code",
        "stdout",
        "stderr",
        "json"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "json": {
          "type": "object"
        },
        "backend": {
          "$ref": "#/$defs/embeddedBackend"
        },
        "required_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "embeddedBackend": {
      "type": "object",
      "required": [
        "kind",
        "command",
        "blocking",
        "required_gaps"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pixi",
            "uv-workspace",
            "missing"
          ]
        },
        "command": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        },
        "required_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "command",
        "external",
        "embedded",
        "semantic_diff",
        "accepted_summary",
        "accepted_differences"
      ],
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^ethos .+"
        },
        "external": {
          "$ref": "#/$defs/commandResult"
        },
        "embedded": {
          "$ref": "#/$defs/commandResult"
        },
        "semantic_diff": {
          "type": "object"
        },
        "accepted_summary": {
          "$ref": "#/$defs/acceptedSummary"
        },
        "accepted_differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptedDifference"
          }
        },
        "false_negative_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "identityEnvelope": {
      "type": "object",
      "required": [
        "target_root",
        "target_head",
        "product_head",
        "changed_paths",
        "commands",
        "external_commands",
        "embedded_commands",
        "evidence_inputs"
      ],
      "properties": {
        "target_root": {
          "type": "string",
          "minLength": 1
        },
        "target_head": {
          "type": "string"
        },
        "product_head": {
          "type": "string"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ethos .+ --json$"
          }
        },
        "external_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "embedded_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceInput"
          }
        }
      },
      "additionalProperties": false
    },
    "evidenceInput": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
