{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/workflow-run.schema.json",
  "title": "ETHOS Workflow Run Snapshot",
  "type": "object",
  "required": [
    "run_id",
    "workflow_id",
    "root",
    "head",
    "state",
    "current_node",
    "pending_actions",
    "source_refs",
    "evidence_refs",
    "truth_boundary"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "root": {"type": "string", "minLength": 1},
    "head": {"type": "string", "minLength": 1},
    "state": {"enum": ["planned", "running", "blocked", "proven", "closed", "aborted"]},
    "current_node": {"type": "string"},
    "pending_actions": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "checkpoint_refs": {"type": "array", "items": {"type": "string"}},
    "retry_count": {"type": "integer", "minimum": 0},
    "truth_boundary": {"const": "generated_until_promoted"}
  },
  "additionalProperties": false
}
