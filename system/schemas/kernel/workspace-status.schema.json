{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/workspace-status.schema.json",
  "title": "ETHOS Workspace Status",
  "type": "object",
  "required": [
    "root",
    "branch",
    "dirty",
    "changed_paths",
    "dirty_provenance",
    "role",
    "role_policy",
    "runtime_binding",
    "landing_readiness",
    "candidate",
    "worktrees",
    "branch_bindings",
    "foreign_work_lanes",
    "coordination_gaps",
    "coordination",
    "closeout_support",
    "stage_gates",
    "required_gaps"
  ],
  "properties": {
    "root": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "dirty": {
      "type": "boolean"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "$ref": "#/$defs/role"
    },
    "role_policy": {
      "$ref": "#/$defs/rolePolicy"
    },
    "runtime_binding": {
      "$ref": "#/$defs/runtimeBinding"
    },
    "landing_readiness": {
      "$ref": "#/$defs/landingReadiness"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "worktrees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/worktree"
      }
    },
    "branch_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/branchBinding"
      }
    },
    "foreign_work_lanes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/foreignWorkLane"
      }
    },
    "coordination_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coordination": {
      "$ref": "#/$defs/coordination"
    },
    "closeout_support": {
      "$ref": "#/$defs/closeoutSupport"
    },
    "required_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dirty_provenance": {
      "$ref": "#/$defs/dirtyProvenance"
    },
    "stage_gates": {
      "$ref": "#/$defs/stageGates"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "release_root",
        "accepted_root",
        "candidate",
        "work_lane",
        "submit_lane",
        "detached",
        "other"
      ]
    },
    "rolePolicy": {
      "type": "object",
      "required": [
        "release_branch",
        "accepted_branch",
        "candidate_branch",
        "work_branch_prefix",
        "submit_branch_prefix",
        "semantic_order"
      ],
      "properties": {
        "release_branch": {
          "type": "string"
        },
        "accepted_branch": {
          "type": "string"
        },
        "candidate_branch": {
          "type": "string"
        },
        "work_branch_prefix": {
          "type": "string"
        },
        "submit_branch_prefix": {
          "type": "string"
        },
        "semantic_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rolePolicyBinding"
          }
        }
      },
      "additionalProperties": false
    },
    "rolePolicyBinding": {
      "type": "object",
      "required": [
        "role",
        "kind",
        "config_key",
        "pattern"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "kind": {
          "enum": [
            "exact_branch",
            "branch_prefix"
          ]
        },
        "config_key": {
          "enum": [
            "release_branch",
            "accepted_branch",
            "candidate_branch",
            "work_branch_prefix",
            "submit_branch_prefix"
          ]
        },
        "pattern": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "worktreeBinding": {
      "type": "string",
      "enum": [
        "current",
        "linked",
        "missing",
        "unbound",
        "absent"
      ]
    },
    "runtimeBinding": {
      "type": "object",
      "required": [
        "kind",
        "state",
        "audit_root",
        "runner_module_path",
        "runner_source_root",
        "schema_source_root",
        "runner_matches_audit_root",
        "schema_matches_audit_root",
        "advisory_gaps",
        "next_action"
      ],
      "properties": {
        "kind": {
          "const": "workspace_status_runtime_binding"
        },
        "state": {
          "enum": [
            "bound_to_audit_root",
            "external_current_runner"
          ]
        },
        "audit_root": {
          "type": "string"
        },
        "runner_module_path": {
          "type": "string"
        },
        "runner_source_root": {
          "type": "string"
        },
        "schema_source_root": {
          "type": "string"
        },
        "runner_matches_audit_root": {
          "type": "boolean"
        },
        "schema_matches_audit_root": {
          "type": "boolean"
        },
        "advisory_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "landingReadiness": {
      "type": "object",
      "required": [
        "kind",
        "state",
        "branch",
        "head",
        "candidate_branch",
        "candidate_head",
        "required_gaps",
        "next_action"
      ],
      "properties": {
        "kind": {
          "const": "landing_readiness"
        },
        "state": {
          "enum": [
            "candidate_base_current",
            "candidate_base_stale",
            "blocked",
            "not_work_lane"
          ]
        },
        "branch": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "candidate_branch": {
          "type": "string"
        },
        "candidate_head": {
          "type": "string"
        },
        "required_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "branch",
        "exists",
        "head",
        "worktree_exists",
        "worktree_path",
        "worktree_binding"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "head": {
          "type": "string"
        },
        "worktree_exists": {
          "type": "boolean"
        },
        "worktree_path": {
          "type": "string"
        },
        "worktree_binding": {
          "enum": [
            "current",
            "linked",
            "missing",
            "unbound",
            "absent"
          ]
        },
        "behind_accepted": {
          "type": "integer",
          "minimum": 0,
          "description": "Commits candidate is behind the accepted root (train-integrity signal)."
        }
      },
      "additionalProperties": false
    },
    "worktree": {
      "type": "object",
      "required": [
        "path",
        "head",
        "branch",
        "role",
        "worktree_binding"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "worktree_binding": {
          "enum": [
            "current",
            "linked",
            "missing"
          ]
        }
      },
      "additionalProperties": false
    },
    "branchBinding": {
      "type": "object",
      "required": [
        "branch",
        "role",
        "head",
        "worktree_path",
        "worktree_binding",
        "claim_id",
        "claim_binding"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "head": {
          "type": "string"
        },
        "worktree_path": {
          "type": "string"
        },
        "worktree_binding": {
          "$ref": "#/$defs/worktreeBinding"
        },
        "claim_id": {
          "type": "string"
        },
        "claim_binding": {
          "enum": [
            "bound",
            "missing",
            "unbound"
          ]
        }
      },
      "additionalProperties": false
    },
    "foreignWorkLane": {
      "type": "object",
      "required": [
        "path",
        "head",
        "branch",
        "role",
        "worktree_binding",
        "lease_state",
        "claim_id",
        "claim_binding",
        "relation_to_accepted",
        "closeout_disposition",
        "residue_state",
        "next_action",
        "dirty",
        "dirty_paths",
        "path_scope",
        "scope_state",
        "coordination_state",
        "handoff_required",
        "lease",
        "action_preview"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "role": {
          "const": "work_lane"
        },
        "worktree_binding": {
          "$ref": "#/$defs/worktreeBinding"
        },
        "lease_state": {
          "enum": [
            "leased",
            "missing"
          ]
        },
        "claim_id": {
          "type": "string"
        },
        "claim_binding": {
          "enum": [
            "bound",
            "missing"
          ]
        },
        "relation_to_accepted": {
          "enum": [
            "ancestor_of_accepted",
            "descendant_of_accepted",
            "diverged_from_accepted",
            "unknown"
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "dirty_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_state": {
          "enum": [
            "bounded",
            "empty",
            "unknown"
          ]
        },
        "coordination_state": {
          "enum": [
            "advisory",
            "disjoint",
            "overlap",
            "unknown"
          ]
        },
        "handoff_required": {
          "type": "boolean"
        },
        "closeout_disposition": {
          "enum": [
            "none",
            "retire_ready",
            "landed_dirty",
            "unlanded",
            "diverged",
            "unknown"
          ]
        },
        "residue_state": {
          "enum": [
            "clean_or_none",
            "unpreserved_worktree_delta"
          ]
        },
        "next_action": {
          "type": "string"
        },
        "lease": {
          "$ref": "#/$defs/leaseSummary"
        },
        "action_preview": {
          "$ref": "#/$defs/actionPreview"
        }
      },
      "additionalProperties": false
    },
    "closeoutSupport": {
      "type": "object",
      "required": [
        "supported",
        "branch",
        "target_branch",
        "target_path",
        "operation",
        "claim_id",
        "claim_binding",
        "required_gaps",
        "holder_ref",
        "lease_id",
        "lease_epoch"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "branch": {
          "type": "string"
        },
        "target_branch": {
          "type": "string"
        },
        "target_path": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "land_to_candidate",
            ""
          ]
        },
        "claim_id": {
          "type": "string"
        },
        "claim_binding": {
          "enum": [
            "bound",
            "missing",
            "unbound"
          ]
        },
        "required_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "holder_ref": {
          "type": "string"
        },
        "lease_id": {
          "type": "string"
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "coordination": {
      "type": "object",
      "required": [
        "kind",
        "blocking",
        "required_gaps",
        "advisory_gaps",
        "invalid_states",
        "foreign_work_lane_count",
        "unbound_work_lane_count",
        "unbound_work_lane_refs",
        "missing_lease_count",
        "overlap_count",
        "unknown_scope_count",
        "closeout_residue_count",
        "dirty_closeout_residue_count",
        "closeout_residue_lanes",
        "next_action",
        "migration_recommendations"
      ],
      "properties": {
        "kind": {
          "const": "work_lane_coordination"
        },
        "blocking": {
          "type": "boolean"
        },
        "required_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advisory_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalid_states": {
          "type": "object"
        },
        "foreign_work_lane_count": {
          "type": "integer",
          "minimum": 0
        },
        "unbound_work_lane_count": {
          "type": "integer",
          "minimum": 0
        },
        "unbound_work_lane_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unboundWorkLaneRef"
          }
        },
        "missing_lease_count": {
          "type": "integer",
          "minimum": 0
        },
        "overlap_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_scope_count": {
          "type": "integer",
          "minimum": 0
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "migration_recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/migrationRecommendation"
          }
        },
        "closeout_residue_count": {
          "type": "integer",
          "minimum": 0
        },
        "dirty_closeout_residue_count": {
          "type": "integer",
          "minimum": 0
        },
        "closeout_residue_lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/closeoutResidueLane"
          }
        }
      },
      "additionalProperties": false
    },
    "unboundWorkLaneRef": {
      "type": "object",
      "required": [
        "branch",
        "head",
        "claim_id",
        "claim_binding",
        "relation_to_accepted",
        "next_action"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "claim_id": {
          "type": "string"
        },
        "claim_binding": {
          "enum": [
            "bound",
            "missing",
            "unbound"
          ]
        },
        "relation_to_accepted": {
          "enum": [
            "ancestor_of_accepted",
            "descendant_of_accepted",
            "diverged_from_accepted",
            "unknown"
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dirtyEntry": {
      "type": "object",
      "required": [
        "path",
        "index",
        "worktree",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "index": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "tracked",
            "untracked",
            "deleted",
            "conflicted"
          ]
        }
      },
      "additionalProperties": false
    },
    "dirtyProvenance": {
      "type": "object",
      "required": [
        "dirty",
        "state",
        "entries",
        "summary"
      ],
      "properties": {
        "dirty": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "clean",
            "dirty",
            "unavailable",
            "non_git"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dirtyEntry"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "migrationRecommendation": {
      "type": "object",
      "required": [
        "kind",
        "overlapping_branch",
        "recommendation",
        "next_actions",
        "holder_ref"
      ],
      "properties": {
        "kind": {
          "const": "overlap_resolution"
        },
        "overlapping_branch": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "holder_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stageGates": {
      "type": "object",
      "required": [
        "authoring_allowed",
        "integration_allowed",
        "accepted_closeout_allowed",
        "blocked_stage",
        "blocker_owner",
        "recommended_next_command",
        "next_commands"
      ],
      "properties": {
        "authoring_allowed": {
          "type": "boolean"
        },
        "integration_allowed": {
          "type": "boolean"
        },
        "accepted_closeout_allowed": {
          "type": "boolean"
        },
        "blocked_stage": {
          "enum": [
            "authoring",
            "candidate_integration",
            "accepted_closeout",
            ""
          ]
        },
        "blocker_owner": {
          "type": "string"
        },
        "recommended_next_command": {
          "type": "string"
        },
        "next_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "closeoutResidueLane": {
      "type": "object",
      "required": [
        "branch",
        "closeout_disposition",
        "residue_state",
        "dirty"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "closeout_disposition": {
          "type": "string"
        },
        "residue_state": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "leaseSummary": {
      "type": "object",
      "required": [
        "lane_incarnation_id",
        "lease_id",
        "holder_ref",
        "epoch",
        "expected_head",
        "expires_at",
        "normalization_state",
        "mints_authority"
      ],
      "properties": {
        "lane_incarnation_id": {
          "type": "string"
        },
        "lease_id": {
          "type": "string"
        },
        "holder_ref": {
          "type": "string"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "expected_head": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        },
        "normalization_state": {
          "type": "string"
        },
        "mints_authority": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "actionPreview": {
      "type": "object",
      "required": [
        "candidate_actions",
        "blocked_actions",
        "why",
        "mints_authority",
        "recheck_required"
      ],
      "properties": {
        "candidate_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mints_authority": {
          "const": false
        },
        "recheck_required": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  }
}
