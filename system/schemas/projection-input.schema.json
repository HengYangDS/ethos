{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethos.local/schemas/projection-input.schema.json",
  "title": "Content-addressed Projection Input",
  "type": "object",
  "required": [
    "schema",
    "title",
    "authority",
    "source",
    "documents",
    "semantics",
    "view",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "projection.input/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "required": [
        "semantic_owner",
        "scope",
        "effect_authority"
      ],
      "properties": {
        "semantic_owner": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "effect_authority": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "git",
        "bindings",
        "documents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/gitObject"
        },
        "git": {
          "type": "object",
          "required": [
            "commit",
            "tree"
          ],
          "properties": {
            "commit": {
              "$ref": "#/$defs/gitObject"
            },
            "tree": {
              "$ref": "#/$defs/gitObject"
            }
          },
          "additionalProperties": false
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceBinding"
          }
        },
        "documents": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/documentBinding"
          }
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "object",
      "required": [
        "copy",
        "view_profile",
        "quality_contract"
      ],
      "properties": {
        "copy": {
          "type": "object"
        },
        "view_profile": {
          "type": "object"
        },
        "quality_contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "semantics": {
      "type": "object",
      "required": [
        "nodes",
        "relations"
      ],
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [
        "nodes",
        "relations"
      ],
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/disposition"
          }
        },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/disposition"
          }
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "sourceBinding": {
      "type": "object",
      "required": [
        "id",
        "path",
        "authority",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "documentBinding": {
      "type": "object",
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "enum": [
            "semantic_graph",
            "copy",
            "view_profile",
            "quality_contract"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "label",
        "kind",
        "provenance",
        "assertion"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assertion": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "provenance",
        "assertion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assertion": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "disposition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "project"
          ],
          "properties": {
            "project": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "omit",
            "reason"
          ],
          "properties": {
            "omit": {
              "const": true
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
